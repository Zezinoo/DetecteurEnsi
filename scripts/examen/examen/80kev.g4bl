*	     cube  scintillateur  CsI
*
* Simple example g4beamline input file:
*	a some MeV gamma or e-  beam is sent towards scintillator detector

###################################################################
#                       Physic list
##################################################################

physics FTFP_BERT_PEN       # seems best for low energy
# _PEN, _EMZ, _LIV

##################################################################
#                     Parameter
#################################################################

# param epsMin=2.5E-8 // no change
param minStep=0.001 // no change
# param maxStep=0.1 //slows down a lot

#################################################################
#                       Color Code
#  Red=1,0,0    Greene=0,1,0    blue=0,0,1    yellow=1,1,0
# opacity=number4 0 to 1 
################################################################.

particlecolor e-=1,0,0 e+=0,0,1 gamma=1,1,0


#####################################################################
#                       BEAM and nEvents
# the beam is nominally headed in the +Z direction, momentum in MeV/c
#
#####################################################################

# Example for e-:
# beam gaussian particle=e- nEvents=10000 beamZ=0.0 sigmaX=1.0 sigmaY=1.0 sigmaXp=0. sigmaYp=0. meanMomentum=sqrt(0.01*(0.01+1.022)) sigmaP=0.0 meanT=0.0 sigmaT=0.0
	
# Example for gamma:
isotropicsource particle=gamma nEvents=100000 meanP=0.08



#################################################################
#			Material
#################################################################

#define CsI: material (Cs(132.9) I(126.9) tot=259.8) density crytur 4.51
material CsI Cs,0.5115 I,0.4885 density=4.51
material Ge Z=32 A=73 density=5.32
material NaI Na,0.1534 I,0.8466 density=3.67
material Al Z=13 A=26.98 density=2.7

################################################################
#                      Detector
################################################################

# define the detectors with opacity 20%

detector GeCylinder radius=25 length=80 color=0,1,0,0.2 material=Ge
detector NaICylinder radius=45 innerRadius=25 length=60 color=1,1,0,0.2 material=NaI
detector AlProtectionNaI innerRadius=45 radius=46.5 length=60 color=0.8,0.8,0.8,1 material=Al
detector AlProtectionGe innerRadius=25 radius=26.5 length=20 color=0.8,0.8,0.8,1 material=Al

detector AlProtectionLidGE radius=25 length=1.5 color=0.8,0.8,0.8,1 material=Al
detector AlProtectionLidJunction radius=45 innerRadius=26.5 length=1.5 color=0.8,0.8,0.8,1 material=Al
detector AlProtectionLidNAI radius=45 length=1.5 color=0.8,0.8,0.8,1 material=Al

place GeCylinder  z=60
place AlProtectionGe z=30
place AlProtectionLidGE z=19.25

place NaICylinder z=70
place AlProtectionNaI z=70
place AlProtectionLidNAI z=100.75


place AlProtectionLidJunction z=39.25

###############################################################
#                   Title
###############################################################

# label the visualization
label text="CsI-Cube" -30,-30,40